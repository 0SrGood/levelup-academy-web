ansparency":1,"BorderSizePixel":0,"Visible":true,"ClipsDescendants":false,"ZIndex":2,"LayoutOrder":0,"Text":"0%","TextColor3":[255,255,255],"TextSize":20,"Font":"Bangers","TextScaled":true,"TextWrapped":false,"TextXAlignment":"Right","TextYAlignment":"Center"}},{"id":"imvi8qt9aw31aj","cls":"UIStroke","name":"UIStroke","parent":"imvi8qt9avxpeh","props":{"Color":[0,0,0],"Thickness":3,"Transparency":0,"ApplyStrokeMode":"Contextual","Enabled":true}},{"id":"imvi8rzivx8bih","cls":"UIStroke","name":"UIStroke","parent":"imvi8kic7p3gll","props":{"Color":[0,0,0],"Thickness":3,"Transparency":0,"ApplyStrokeMode":"Contextual","Enabled":true}},{"id":"imvi91fla1sdpd7","cls":"Part","name":"checkpoint","parent":"imvh507g9dc6g0","props":{"Color":[99,95,98],"Material":"Plastic","Transparency":0,"Reflectance":0,"Shape":"Block","Position":[0.1,7.08,35.066],"Orientation":[0,0,0],"Size":[6,0.522,6],"Anchored":true,"CanCollide":true,"CanTouch":true,"Locked":false}},{"id":"imvi977qy1ur2zw","cls":"Script","name":"Object","parent":"ServerScriptService","props":{"Enabled":true,"Source":"local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Players = game:GetService(\"Players\")\n\nlocal checkpointEvent = ReplicatedStorage.Remote.Event.Checkpoint\n\nlocal Challanges = workspace.Map.Challanges\nlocal checkpoints = {}\n\nfor _, item in ipairs(Challanges:GetDescendants()) do\n    if item:IsA(\"BasePart\") and item.Name == \"checkpoint\" then\n        \n        item.Touched:Connect(function(hit)\n            if not hit.Parent:FindFirstChild(\"Humanoid\") then\n                return\n            end\n            \n            local Character = hit.Parent\n            local Player = Players:FindFirstChild(Character.Name)\n            if not Player then return end\n            \n            local leaderstats = Player:WaitForChild(\"leaderstats\")\n            local fases = leaderstats:WaitForChild(\"Fases\")\n            \n            if not checkpoints[item] then\n                checkpoints[item] = {}\n            end\n            \n            if checkpoints[item][Player] then\n                return\n            end\n            \n            checkpoints[item][Player] = true\n            fases.Value += 1\n            checkpointEvent:FireClient(Player, fases.Value-1)\n        end)\n    end\nend\n\n\n\n"}},{"id":"imvi99d5t1v1l4e","cls":"Script","name":"Stats","parent":"ServerScriptService","props":{"Enabled":true,"Source":"local Players = game:GetService(\"Players\")\n\nPlayers.PlayerAdded:Connect(function(player)\n    local leaderstats = Instance.new(\"Folder\")\n    leaderstats.Name = \"leaderstats\"\n    leaderstats.Parent = player\n    \n    local Fases = Instance.new(\"IntValue\")\n    Fases.Name = \"Fases\"\n    Fases.Value = 1\n    Fases.Parent = leaderstats\n    \n    local playerLoadedStat = Instance.new(\"BoolValue\")\n    playerLoadedStat.Name = \"playerLoaded\"\n    playerLoadedStat.Parent = player\nend)"}},{"id":"imvi9tr7x368wcg","cls":"LocalScript","name":"CheckpointClientScript","parent":"StarterPlayer","props":{"Enabled":true,"Source":"local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal checkpointEvent = ReplicatedStorage.Remote.Event.Checkpoint\n\nlocal challanges = workspace.Map.Challanges\n\ncheckpointEvent.OnClientEvent:Connect(function(checkpointNumber)\n    print(\"Evento chamado!\")\n    local stage = challanges:FindFirstChild(\"Stage_\"..checkpointNumber)\n    if not stage then warn(\"Esse estágio não existe!\") return end\n    \n    local checkpointPart = stage:FindFirstChild(\"checkpoint\")\n    if not checkpointPart then \n        warn(\"Estágio \" .. checkpointNumber .. \" sem checkpoint!\")\n        return\n    end\n    \n    checkpointPart.Color = Color3.fromRGB(0, 255, 0)\nend)"}},{"id":"imvi9u16f37lrep","cls":"Folder","name":"Remote","parent":"ReplicatedStorage","props":{}},{"id":"imvi9u5l538hg2j","cls":"Folder","name":"Event","parent":"imvi9u16f37lrep","props":{}},{"id":"imvi9udrl39059p","cls":"Folder","name":"Function","parent":"imvi9u16f37lrep","props":{}},{"id":"imvi9uk603a0j62","cls":"RemoteEvent","name":"Checkpoint","parent":"imvi9u5l538hg2j","props":{}},{"id":"imvia3yin3bj53l","cls":"Script","name":"Checkpoint","parent":"ServerScriptService","props":{"Enabled":true,"Source":"local Players = game:GetService(\"Players\")\nlocal Challanges = workspace.Map.Challanges\n\nPlayers.PlayerAdded:Connect(function(player)\n    player.CharacterAdded:Connect(function(character)\n        local leaderstats = player:WaitForChild(\"leaderstats\")\n        local fases = leaderstats:WaitForChild(\"Fases\")\n        \n        local stage = Challanges:FindFirstChild(\"Stage_\"..fases.Value-1)\n        if not stage then warn(\"Estágio \" .. fases.Value-1 .. \" não existe\") return end\n        \n        local checkpoint = stage:FindFirstChild(\"checkpoint\")\n        if not checkpoint then return end\n        \n        task.delay(.2, function()\n            character:PivotTo(checkpoint.CFrame * CFrame.new(0, 3, 0))\n        end)\n    end)\nend)\n"}},{"id":"imviaifil3c7clr","cls":"Part","name":"checkpoint","parent":"imvh74g11brou6","props":{"Color":[99,95,98],"Material":"Plastic","Transparency":0,"Reflectance":0,"Shape":"Block","Position":[-40.843,8.065,34.503],"Orientation":[0,0,0],"Size":[6,0.522,6],"Anchored":true,"CanCollide":true,"CanTouch":true,"Locked":false}},{"id":"imvibklng3dom1k","cls":"Part","name":"Part","parent":"Workspace","props":{"Color":[160,95,53],"Material":"Granite","Transparency":0,"Reflectance":0,"Shape":"Block","Position":[-0.181,-4.743,-4.414],"Orientation":[0,0,0],"Size":[16.418,8.15,17.52],"Anchored":true,"CanCollide":true,"CanTouch":true,"Locked":false}},{"id":"imviblwon3eybql","cls":"LocalScript","name":"StagesClientScript","parent":"imvi8i4u0mwuzc","props":{"Enabled":true,"Source":"local TweenService = game:GetService(\"TweenService\")\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\nlocal Challanges = workspace.Map.Challanges\n\nrepeat\n    task.wait(1)\nuntil player:FindFirstChild(\"playerLoaded\")\n\nlocal Frame = script.Parent\nlocal stageAmount = Frame.stage\nlocal stageProgressBar = Frame.stageProgress.bar\nlocal stageProgressText = Frame.stageProgress.amount\n\nlocal leaderstats = player:WaitForChild(\"leaderstats\")\nlocal fases = leaderstats:WaitForChild(\"Fases\")\n\nlocal function porcentagem(num)\n    return math.floor(num*100/#Challanges:GetChildren())\nend\n\nlocal function updateStage(amount)\n    stageAmount.Text = amount < 1 and \"Lobby\" or \"Fase \"..amount\n    stageProgressText.Text = porcentagem(amount) .. \"%\"\n    stageProgressBar.Size = UDim2.fromScale(amount/#Challanges:GetChildren(), 1)\nend\n\nupdateStage(fases.Value-1)\n\nfases.Changed:Connect(function()\n    updateStage(fases.Value-1)\nend)\n"}},{"id":"imvic9o503fufzl","cls":"Model","name":"Stage_3","parent":"imvh532muivrei","props":{}},{"id":"imvic9o503gvl6a","cls":"Model","name":"Challange","parent":"imvic9o503fufzl","props":{}},{"id":"imvic9o503lc526","cls":"Part","name":"EndPart","parent":"imvic9o503fufzl","props":{"Color":[160,95,53],"Material":"Plastic","Transparency":0,"Reflectance":0,"Shape":"Block","Position":[-41.6,8.486,-33.864],"Orientation":[0,-90,0],"Size":[12.41,1,13.698],"Anchored":true,"CanCollide":true,"CanTouch":true,"Locked":false}},{"id":"imvic9o503mv6xa","cls":"Part","name":"Handle","parent":"imvic9o503fufzl","props":{"Color":[163,162,165],"Material":"Plastic","Transparency":1,"Reflectance":0,"Shape":"Block","Position":[-41.63,12.432,-34.795],"Orientation":[0,90,0],"Size":[11.048,9.173,10.281],"Anchored":true,"CanCollide":false,"CanTouch":true,"Locked":false}},{"id":"imvic9o503nwr6k","cls":"Part","name":"checkpoint","parent":"imvic9o503fufzl","props":{"Color":[99,95,98],"Material":"Plastic","Transparency":0,"Reflectance":0,"Shape":"Block","Position":[-41.679,9.099,-33.867],"Orientation":[0,-90,0],"Size":[6,0.522,6],"Anchored":true,"CanCollide":true,"CanTouch":tr