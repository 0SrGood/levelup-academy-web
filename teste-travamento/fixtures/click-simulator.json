{"v":1,"name":"Experiência sem título","insts":[{"id":"Workspace","cls":"Workspace","name":"Workspace","parent":null,"props":{"Gravity":196.2}},{"id":"Players","cls":"Players","name":"Players","parent":null,"props":{}},{"id":"Lighting","cls":"Lighting","name":"Lighting","parent":null,"props":{"ClockTime":14,"Brightness":2}},{"id":"ReplicatedStorage","cls":"ReplicatedStorage","name":"ReplicatedStorage","parent":null,"props":{}},{"id":"ServerScriptService","cls":"ServerScriptService","name":"ServerScriptService","parent":null,"props":{}},{"id":"ServerStorage","cls":"ServerStorage","name":"ServerStorage","parent":null,"props":{}},{"id":"StarterPlayer","cls":"StarterPlayer","name":"StarterPlayer","parent":null,"props":{}},{"id":"StarterGui","cls":"StarterGui","name":"StarterGui","parent":null,"props":{}},{"id":"StarterPlayerScripts","cls":"StarterPlayerScripts","name":"StarterPlayerScripts","parent":"StarterPlayer","props":{}},{"id":"StarterCharacterScripts","cls":"StarterCharacterScripts","name":"StarterCharacterScripts","parent":"StarterPlayer","props":{}},{"id":"imviojx9t0pyfm","cls":"Part","name":"Baseplate","parent":"Workspace","props":{"Color":[91,93,105],"Material":"Plastic","Transparency":0,"Reflectance":0,"Shape":"Block","Position":[0,-8,0],"Orientation":[0,0,0],"Size":[512,16,512],"Anchored":true,"CanCollide":true,"CanTouch":true,"Locked":true}},{"id":"imviojx9t1g5tz","cls":"SpawnLocation","name":"SpawnLocation","parent":"Workspace","props":{"Color":[163,162,165],"Material":"Plastic","Transparency":0,"Reflectance":0,"Shape":"Block","Position":[3,0.5,-2],"Orientation":[0,0,0],"Size":[12,1,12],"Anchored":true,"CanCollide":true,"CanTouch":true,"Locked":false}},{"id":"imviojx9t2lw9f","cls":"Script","name":"Learderstats","parent":"ServerScriptService","props":{"Enabled":true,"Source":"\nlocal Players = game:GetService(\"Players\")\n\nlocal function setupLeaderstats(player)\n    local leaderstats = Instance.new(\"Folder\")\n    leaderstats.Name = \"leaderstats\"\n    leaderstats.Parent = player\n\n    local Cliques = Instance.new(\"IntValue\")\n    Cliques.Name = \"Cliques\"\n    Cliques.Value = 0\n    Cliques.Parent = leaderstats\nend\n\nPlayers.PlayerAdded:Connect(setupLeaderstats)\n\nfor _, player in ipairs(Players:GetPlayers()) do\n    setupLeaderstats(player)\nend\n\n"}},{"id":"imvioknp53nx69","cls":"ScreenGui","name":"ScreenGui","parent":"StarterGui","props":{"Enabled":true}},{"id":"imviokpis4cx1y","cls":"TextButton","name":"BotãoDeCliques","parent":"imvioknp53nx69","props":{"Position":[0.487,0,0.761,0],"Size":[0.076,0,0.185,0],"AnchorPoint":[0,0],"Rotation":0,"BackgroundColor3":[255,255,255],"BackgroundTransparency":0,"BorderSizePixel":0,"Visible":true,"ClipsDescendants":false,"ZIndex":1,"LayoutOrder":0,"Text":"","TextColor3":[27,42,53],"TextSize":20,"Font":"SourceSans","TextScaled":true,"TextWrapped":false,"TextXAlignment":"Center","TextYAlignment":"Center"}},{"id":"imviolb1o5lz4x","cls":"UICorner","name":"UICorner","parent":"imviokpis4cx1y","props":{"CornerRadius":[1,0]}},{"id":"imviomqz66wmyt","cls":"UIGradient","name":"UIGradient","parent":"imviokpis4cx1y","props":{"Color":[[0,248,248,248],[1,159,161,172]],"Rotation":90,"Enabled":true}},{"id":"imvioo4wq7oayj","cls":"ImageLabel","name":"ImageLabel","parent":"imviokpis4cx1y","props":{"Position":[0,0,0,0],"Size":[1,0,0.9,0],"AnchorPoint":[0,0],"Rotation":0,"BackgroundColor3":[255,255,255],"BackgroundTransparency":1,"BorderSizePixel":0,"Visible":true,"ClipsDescendants":false,"ZIndex":1,"LayoutOrder":0,"Image":"/api/media/00000000-0000-4000-8000-000000000000","ImageColor3":[255,255,255],"ImageTransparency":0,"ScaleType":"Fit"}},{"id":"imviov5yj889yo","cls":"UIStroke","name":"UIStroke","parent":"imviokpis4cx1y","props":{"Color":[0,0,0],"Thickness":2,"Transparency":0,"ApplyStrokeMode":"Border","Enabled":true}},{"id":"imvip225b93gjw","cls":"LocalScript","name":"LocalScript","parent":"imviokpis4cx1y","props":{"Enabled":true,"Source":"\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Button = script.Parent\nlocal ClickEvent = ReplicatedStorage:WaitForChild(\"AddClick\")\n\nButton.Activated:Connect(function()\n    ClickEvent:FireServer()\nend)\n\n"}},{"id":"imvip2qwzbv4l6","cls":"Script","name":"ClickHandler","parent":"ServerScriptService","props":{"Enabled":true,"Source":"\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Players = game:GetService(\"Players\")\n\nlocal ClickEvent = Instance.new(\"RemoteEvent\")\nClickEvent.Name = \"AddClick\"\nClickEvent.Parent = ReplicatedStorage\n\nlocal LastClick = {}\n\nClickEvent.OnServerEvent:Connect(function(Player)\n    local Now = os.clock()\n\n    if LastClick[Player] and Now - LastClick[Player] < 0.05 then\n        return\n    end\n\n    LastClick[Player] = Now\n\n    local Leaderstats = Player:FindFirstChild(\"leaderstats\")\n    if not Leaderstats then\n        return\n    end\n\n    local Cliques = Leaderstats:FindFirstChild(\"Cliques\")\n    if not Cliques then\n        return\n    end\n\n    Cliques.Value += 1\nend)\n\nPlayers.PlayerRemoving:Connect(function(Player)\n    LastClick[Player] = nil\nend)\n\n"}},{"id":"imvip4pf1cdm13","cls":"TextLabel","name":"TextoDosPontos","parent":"imvioknp53nx69","props":{"Position":[0.896,0,0.893,0],"Size":[0.079,0,0.076,0],"AnchorPoint":[0,0],"Rotation":0,"BackgroundColor3":[17,17,17],"BackgroundTransparency":1,"BorderSizePixel":0,"Visible":true,"ClipsDescendants":false,"ZIndex":1,"LayoutOrder":0,"Text":"100","TextColor3":[248,248,248],"TextSize":20,"Font":"Bangers","TextScaled":true,"TextWrapped":false,"TextXAlignment":"Left","TextYAlignment":"Center"}},{"id":"imvip7du3dnrl9","cls":"ImageLabel","name":"ImageLabel","parent":"imvip4pf1cdm13","props":{"Position":[0.482,0,-0.156,0],"Size":[0.551,0,1.313,0],"AnchorPoint":[0,0],"Rotation":0,"BackgroundColor3":[255,255,255],"BackgroundTransparency":1,"BorderSizePixel":0,"Visible":true,"ClipsDescendants":false,"ZIndex":1,"LayoutOrder":0,"Image":"/api/media/00000000-0000-4000-8000-000000000000","ImageColor3":[255,255,255],"ImageTransparency":0,"ScaleType":"Fit"}},{"id":"imvipabrvfbdx1","cls":"UIStroke","name":"UIStroke","parent":"imvip4pf1cdm13","props":{"Color":[0,0,0],"Thickness":3,"Transparency":0,"ApplyStrokeMode":"Contextual","Enabled":true}},{"id":"imvipd8p7ggx94","cls":"LocalScript","name":"LocalScript","parent":"imvip4pf1cdm13","props":{"Enabled":true,"Source":"\nlocal Players = game:GetService(\"Players\")\n\nlocal Player = Players.LocalPlayer\nlocal TextLabel = script.Parent\n\nlocal Leaderstats = Player:WaitForChild(\"leaderstats\")\nlocal Cliques = Leaderstats:WaitForChild(\"Cliques\")\n\nlocal function AtualizarTexto()\n    TextLabel.Text = tostring(Cliques.Value)\nend\n\nCliques:GetPropertyChangedSignal(\"Value\"):Connect(AtualizarTexto)\n\nAtualizarTexto()\n\n"}},{"id":"imvipx17rnh9sk","cls":"TextButton","name":"TextButton","parent":"imvioknp53nx69","props":{"Position":[0.025,0,0.448,0],"Size":[0.065,0,0.159,0],"AnchorPoint":[0,0],"Rotation":0,"BackgroundColor3":[255,255,255],"BackgroundTransparency":0,"BorderSizePixel":0,"Visible":true,"ClipsDescendants":false,"ZIndex":1,"LayoutOrder":0,"Text":"","TextColor3":[27,42,53],"TextSize":20,"Font":"SourceSans","TextScaled":true,"TextWrapped":false,"TextXAlignment":"Center","TextYAlignment":"Center"}},{"id":"imvipxa1box1de","cls":"UICorner","name":"UICorner","parent":"imvipx17rnh9sk","props":{"CornerRadius":[1,0]}},{"id":"imvipxur6pbi2p","cls":"ImageLabel","name":"ImageLabel","parent":"imvipx17rnh9sk","props":{"Position":[0.1,0,0,0],"Size":[0.82,0,1,0],"AnchorPoint":[0,0],"Rotation":0,"BackgroundColor3":[255,255,255],"BackgroundTransparency":1,"BorderSizePixel":0,"Visible":true,"ClipsDescendants":false,"ZIndex":1,"LayoutOrder":0,"Image":"/api/media/00000000-0000-4000-8000-000000000000","ImageColor3":[255,255,255],"ImageTransparency":0,"ScaleType":"Fit"}},{"id":"imvipyolxqjah4","cls":"UIGradient","name":"UIGradient","parent":"imvipx17rnh9sk","props":{"Color":[[0,255,89,89],[1,255,0,0]],"Rotation":0,"Enabled":true}},{"id":"imvipzubjrq74g","cls":"UIStroke","name":"UIStroke","parent":"imvipx17rnh9sk","props":{"Color":[0,0,0],"Thickness":3,"Transparency":0.5,"ApplyStrokeMode":"Border","Enabled":true}},{"id":"imviq4j3kx65gf","cls":"Frame","name":"Frame","parent":"imvioknp53nx69","props":{"Position":[0.125,0,0.248,0],"Size":[0.174,0,0.558,0],"AnchorPoint":[0,0],"Rotation":0,"BackgroundColor3":[255,0,0],"BackgroundTransparency":0,"BorderSizePixel":0,"Visible":true,"ClipsDescendants":false,"ZIndex":1,"LayoutOrder":0}},{"id":"imviq5tp1yig34","cls":"ImageLabel","name":"ImageLabel","parent":"imviqyizazr9du","props":{"Position":[0.719,0,0,0],"Size":[0.439,0,0.921,0],"AnchorPoint":[0,0],"Rotation":0,"BackgroundColor3":[255,255,255],"BackgroundTransparency":1,"BorderSizePixel":0,"Visible":true,"ClipsDescendants":false,"ZIndex":1,"LayoutOrder":0,"Image":"/api/media/00000000-0000-4000-8000-000000000000","ImageColor3":[255,255,255],"ImageTransparency":0,"ScaleType":"Fit"}},{"id":"imviqyizazr9du","cls":"TextButton","name":"TextButton","parent":"imvioknp53nx69","props":{"Position":[0.125,0,0.32,0],"Size":[0.161,0,0.061,0],"AnchorPoint":[0,0],"Rotation":0,"BackgroundColor3":[255,255,255],"BackgroundTransparency":1,"BorderSizePixel":0,"Visible":true,"ClipsDescendants":false,"ZIndex":1,"LayoutOrder":0,"Text":"Necessario 100","TextColor3":[242,243,243],"TextSize":20,"Font":"Bangers","TextScaled":true,"TextWrapped":false,"TextXAlignment":"Center","TextYAlignment":"Center"}},{"id":"imvir69ff11yn5s","cls":"UIStroke","name":"UIStroke","parent":"imviqyizazr9du","props":{"Color":[0,0,0],"Thickness":2,"Transparency":0,"ApplyStrokeMode":"Contextual","Enabled":true}},{"id":"imvir8ddz1233mt","cls":"TextButton","name":"TextButton","parent":"imvioknp53nx69","props":{"Position":[0.125,0,0.466,0],"Size":[0.161,0,0.061,0],"AnchorPoint":[0,0],"Rotation":0,"BackgroundColor3":[255,255,255],"BackgroundTransparency":1,"BorderSizePixel":0,"Visible":true,"ClipsDescendants":false,"ZIndex":1,"LayoutOrder":0,"Text":"Necessario 500","TextColor3":[242,243,243],"TextSize":20,"Font":"Bangers","TextScaled":true,"TextWrapped":false,"TextXAlignment":"Center","TextYAlignment":"Center"}},{"id":"imvir8ddz14lin1","cls":"UIStroke","name":"UIStroke","parent":"imvir8ddz1233mt","props":{"Color":[0,0,0],"Thickness":2,"Transparency":0,"ApplyStrokeMode":"Contextual","Enabled":true}},{"id":"imvir8y8615nac6","cls":"UIStroke","name":"UIStroke","parent":"imviqyizazr9du","props":{"Color":[0,0,0],"Thickness":2,"Transparency":0,"ApplyStrokeMode":"Contextual","Enabled":true}},{"id":"imvir92nz16l42h","cls":"ImageLabel","name":"ImageLabel","parent":"imviqyizazr9du","props":{"Position":[0.719,0,2.422,0],"Size":[0.439,0,0.921,0],"AnchorPoint":[0,0],"Rotation":0,"BackgroundColor3":[255,255,255],"BackgroundTransparency":1,"BorderSizePixel":0,"Visible":true,"ClipsDescendants":false,"ZIndex":1,"LayoutOrder":0,"Image":"/api/media/00000000-0000-4000-8000-000000000000","ImageColor3":[255,255,255],"ImageTransparency":0,"ScaleType":"Fit"}},{"id":"imvira5ce17cpng","cls":"Part","name":"Part","parent":"imvioknp53nx69","props":{"Color":[163,162,165],"Material":"Plastic","Transparency":0,"Reflectance":0,"Shape":"Block","Position":[0,0.5,15],"Orientation":[0,0,0],"Size":[4,1,2],"Anchored":true,"CanCollide":true,"CanTouch":true,"Locked":false}},{"id":"imvirabxi18awp9","cls":"TextButton","name":"TextButton","parent":"imvioknp53nx69","props":{"Position":[0.125,0,0.607,0],"Size":[0.161,0,0.061,0],"AnchorPoint":[0,0],"Rotation":0,"BackgroundColor3":[255,255,255],"BackgroundTransparency":1,"BorderSizePixel":0,"Visible":true,"ClipsDescendants":false,"ZIndex":1,"LayoutOrder":0,"Text":"Necessario 1000","TextColor3":[242,243,243],"TextSize":20,"Font":"Bangers","TextScaled":true,"TextWrapped":false,"TextXAlignment":"Center","TextYAlignment":"Center"}},{"id":"imvirabxi19zsu9","cls":"UIStroke","name":"UIStroke","parent":"imvirabxi18awp9","props":{"Color":[0,0,0],"Thickness":2,"Transparency":0,"ApplyStrokeMode":"Contextual","Enabled":true}},{"id":"imviraoen1a52eh","cls":"ImageLabel","name":"ImageLabel","parent":"imviqyizazr9du","props":{"Position":[0.719,0,4.687,0],"Size":[0.439,0,0.921,0],"AnchorPoint":[0,0],"Rotation":0,"BackgroundColor3":[255,255,255],"BackgroundTransparency":1,"BorderSizePixel":0,"Visible":true,"ClipsDescendants":false,"ZIndex":1,"LayoutOrder":0,"Image":"/api/media/00000000-0000-4000-8000-000000000000","ImageColor3":[255,255,255],"ImageTransparency":0,"ScaleType":"Fit"}},{"id":"imvirnoyz1bm49l","cls":"Script","name":"RebirthHandler","parent":"ServerScriptService","props":{"Enabled":true,"Source":"\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal RebirthEvent = ReplicatedStorage:FindFirstChild(\"RequestRebirth\")\n\nif not RebirthEvent then\n    RebirthEvent = Instance.new(\"RemoteEvent\")\n    RebirthEvent.Name = \"RequestRebirth\"\n    RebirthEvent.Parent = ReplicatedStorage\nend\n\nlocal Options = {\n    Rebirth1 = {Price = 100, Amount = 1},\n    Rebirth5 = {Price = 500, Amount = 5},\n    Rebirth10 = {Price = 1000, Amount = 10}\n}\n\nRebirthEvent.OnServerEvent:Connect(function(Player, OptionName)\n    local Option = Options[OptionName]\n    if not Option then\n        return\n    end\n\n    local Leaderstats = Player:FindFirstChild(\"leaderstats\")\n    if not Leaderstats then\n        return\n    end\n\n    local Cliques = Leaderstats:FindFirstChild(\"Cliques\")\n    local Rebirths = Leaderstats:FindFirstChild(\"Rebirths\")\n\n    if not Cliques or not Rebirths then\n        return\n    end\n\n    if Cliques.Value < Option.Price then\n        return\n    end\n\n    Cliques.Value = 0\n    Rebirths.Value += Option.Amount\nend)\n\n"}},{"id":"imvirsjn51c1pya","cls":"LocalScript","name":"RebirthButton","parent":"imvioknp53nx69","props":{"Enabled":true,"Source":"\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Players = game:GetService(\"Players\")\n\nlocal Player = Players.LocalPlayer\nlocal GUI = script.Parent\n\nlocal Leaderstats = Player:WaitForChild(\"leaderstats\")\nlocal Cliques = Leaderstats:WaitForChild(\"Cliques\")\n\nlocal RebirthEvent = ReplicatedStorage:WaitForChild(\"RequestRebirth\")\n\nlocal Options = {\n    Rebirth1 = 100,\n    Rebirth5 = 500,\n    Rebirth10 = 1000\n}\n\nfor Name, Price in pairs(Options) do\n    local Frame = GUI:FindFirstChild(Name, true)\n\n    if not Frame then\n        warn(\"Frame nao encontrada:\", Name)\n        continue\n    end\n\n    local Button = Frame:WaitForChild(\"Comprar\")\n    local NecessaryLabel = Frame:WaitForChild(\"Necessario\")\n\n    local function Update()\n        NecessaryLabel.Text = \"Necessario: \" .. Price\n\n        if Cliques.Value >= Price then\n            Button.BackgroundColor3 = Color3.fromRGB(60, 200, 100)\n        else\n            Button.BackgroundColor3 = Color3.fromRGB(120, 120, 120)\n        end\n    end\n\n    Button.Activated:Connect(function()\n        if Cliques.Value < Price then\n            return\n        end\n\n        RebirthEvent:FireServer(Name)\n    end)\n\n    Cliques:GetPropertyChangedSignal(\"Value\"):Connect(Update)\n\n    Update()\nend\n\n"}}]}